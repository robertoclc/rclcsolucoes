---

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

const title =
  "RCLC – Soluções Gerenciais | Tecnologia e Presença Digital";

const description =
  "A RCLC oferece soluções gerenciais, tecnologia e presença digital para empresas que buscam organização, comunicação profissional e resultados.";
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <Hero />
  </main>

  <Footer />
</Layout>