---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title =
  "Contato | Fale com a RCLC sobre Google, Sites e Presença Digital";

const description =
  "Entre em contato com a RCLC para conhecer nossos serviços de Perfil da Empresa no Google, Google Maps, criação e atualização de sites e presença digital.";
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <Contact />
  </main>

  <Footer />
</Layout>