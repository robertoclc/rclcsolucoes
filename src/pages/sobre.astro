---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";

const title =
  "Sobre a RCLC | Tecnologia, Sites e Presença Digital";

const description =
  "Conheça a RCLC e nosso trabalho com presença digital, criação e atualização de sites e Perfil da Empresa no Google. Soluções práticas para empresas que desejam fortalecer sua presença na internet.";
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <About />
  </main>

  <Footer />
</Layout>