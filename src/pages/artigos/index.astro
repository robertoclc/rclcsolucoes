---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const title = "Artigos e Dicas sobre Presença Digital | RCLC Soluções Gerenciais";

const description =
  "Confira artigos e dicas da RCLC sobre Perfil da Empresa no Google, Google Meu Negócio, Google Maps, sites e presença digital para empresas.";

const articles = [
  {
    category: "GOOGLE E PRESENÇA DIGITAL",
    title: "Como Usar o Posicionamento no Google Meu Negócio para Atrair Mais Clientes",
    description:
      "Entenda como manter o Perfil da Empresa no Google atualizado, apresentar seus produtos e serviços e facilitar que os clientes encontrem seu negócio na Pesquisa Google e no Maps.",
    date: "02 de Novembro de 2026",
    author: "RCLC Soluções Gerenciais",
    image: "/images/artigo-google-card.png",
    imageAlt: "Ilustração sobre presença de empresas no Google",
    href: "/artigos/google-servicos",
  },
];
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <section class="articles-hero">
      <div class="container">
        <span class="section-label">CONHECIMENTO E INFORMAÇÃO</span>
        <h1>Artigos e dicas para fortalecer sua presença digital</h1>
        <p>
          Conteúdos práticos sobre tecnologia, Google, sites e soluções
          digitais para ajudar sua empresa a se apresentar melhor na internet.
        </p>
      </div>
    </section>

    <section class="articles-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-label">NOSSOS CONTEÚDOS</span>
            <h2>Artigos publicados</h2>
          </div>
        </div>

        <div class="articles-grid">
          {articles.map((article) => (
            <article class="article-card">
              <a href={article.href} class="article-image-link">
                <img
                  src={article.image}
                  alt={article.imageAlt}
                  loading="lazy"
                  width="800"
                  height="450"
                />
              </a>

              <div class="article-content">
                <span class="article-category">{article.category}</span>

                <h3>
                  <a href={article.href}>{article.title}</a>
                </h3>

                <div class="article-meta">
                  <span>{article.date}</span>
                  <span>Por {article.author}</span>
                </div>

                <p>{article.description}</p>

                <a href={article.href} class="read-more">
                  Ler artigo <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="articles-cta">
      <div class="container">
        <h2>Precisa melhorar a presença digital da sua empresa?</h2>
        <p>
          A RCLC pode ajudar a organizar suas informações, atualizar seu perfil
          no Google e fortalecer seus canais digitais.
        </p>
        <a
          href="https://wa.me/5521993548498"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          Fale com a RCLC pelo WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .articles-hero {
    padding: 75px 0 70px;
    background: #f6f9fc;
  }

  .section-label {
    display: block;
    margin-bottom: 14px;
    color: #1677d2;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .articles-hero h1 {
    max-width: 780px;
    margin: 0 0 18px;
    color: #10243f;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .articles-hero p {
    max-width: 720px;
    margin: 0;
    color: #596a80;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .articles-section {
    padding: 70px 0 85px;
    background: #ffffff;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 35px;
  }

  .section-heading .section-label {
    margin-bottom: 8px;
  }

  .section-heading h2 {
    margin: 0;
    color: #10243f;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }

  .section-heading > p {
    max-width: 400px;
    margin: 0;
    color: #596a80;
    line-height: 1.6;
  }

  .articles-grid {
  display: grid;
  grid-template-columns: minmax(0, 780px);
  justify-content: center;
  gap: 28px;
}
  }

  .article-card {
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(16, 36, 63, 0.09);
  }

  .article-image-link {
  display: block;
  overflow: hidden;
  width: 100%;
  max-height: 300px;
  aspect-ratio: 16 / 9;
  background: #f0f4f8;
}

  .article-image-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-card:hover .article-image-link img {
    transform: scale(1.03);
  }

  .article-content {
    padding: 25px;
  }

  .article-category {
    color: #1677d2;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .article-content h3 {
    margin: 12px 0;
    color: #10243f;
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .article-content h3 a {
    color: inherit;
    text-decoration: none;
  }

  .article-content h3 a:hover {
    color: #1677d2;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 15px;
    margin-bottom: 15px;
    color: #8c9ba8;
    font-size: 0.8rem;
  }

  .article-content > p {
    margin: 0 0 20px;
    color: #596a80;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #1268b9;
    font-weight: 700;
    text-decoration: none;
  }

  .read-more:hover {
    color: #0f579c;
  }

  .articles-cta {
    padding: 65px 0;
    text-align: center;
    background: #f6f9fc;
  }

  .articles-cta h2 {
    margin: 0 0 14px;
    color: #10243f;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .articles-cta p {
    max-width: 680px;
    margin: 0 auto 25px;
    color: #596a80;
    line-height: 1.7;
  }

  .btn-whatsapp {
    display: inline-block;
    padding: 13px 25px;
    color: #ffffff;
    background: #1268b9;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-whatsapp:hover {
    color: #ffffff;
    background: #0f579c;
  }

  @media (max-width: 768px) {
    .articles-hero {
      padding: 50px 0;
    }

    .articles-section {
      padding: 50px 0 60px;
    }

    .section-heading {
      display: block;
    }

    .section-heading > p {
      margin-top: 15px;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .article-content {
      padding: 22px;
    }

    .articles-cta {
      padding: 50px 0;
    }
  }
</style>