---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Portfolio from "../components/Portfolio.astro";
import Footer from "../components/Footer.astro";

const title =
  "Portfólio RCLC | Sites e Projetos de Presença Digital";

const description =
  "Conheça os sites e projetos digitais desenvolvidos pela RCLC para empresas e diferentes segmentos, com foco em tecnologia, comunicação e presença online.";
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <Portfolio />
  </main>

  <Footer />
</Layout>